{
  "id": "ai-tagger",
  "name": "AI 自动标签",
  "description": "使用本地 WD、视觉语言和向量模型为 Pixcall 素材打标签、生成注释并进行语义搜索。",
  "version": "2.0.1",
  "author": "kankan",
  "homepage": "https://github.com/bukkumaaku/pixcall-tagger",
  "icon": "icon.png",
  "plugin_type": "modal",
  "main": "index.html",
  "minimum_core_version": "0.9.5",
  "manifest_version": 2,
  "window": {
    "width": 1250,
    "height": 850,
    "min_width": 960,
    "min_height": 640,
    "max_width": 1800,
    "max_height": 1200,
    "resizable": true,
    "movable": true,
    "modal": false
  },
  "contributes": {
    "commands": [
      {
        "command": "ai-tagger",
        "title": "AI 自动标签",
        "icon": {
          "light": "icon.png",
          "dark": "icon.png"
        }
      }
    ],
    "context_menus": [
      {
        "command": "ai-tagger",
        "when": "has_selection"
      }
    ]
  },
  "l10n": "./l10n",
  "default_locale": "zh-CN"
}
