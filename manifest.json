{
  "id": "ai-tagger",
  "name": "AI 自动标签",
  "description": "使用本地 WD、视觉语言和向量模型为 Pixcall 素材打标签、生成注释并进行语义搜索。",
  "version": "2.2.5",
  "author": "kankan",
  "homepage": "https://github.com/bukkumaaku/pixcall-tagger",
  "icon": "icon.png",
  "minimum_core_version": "0.9.7",
  "manifest_version": 2,
  "platform_arch": ["windows-x64", "macos-arm64"],
  "permissions": {
    "fs": { "read": true, "write": true },
    "sqlite": { "read": true, "write": true },
    "storage": true
  },
  "contributes": {
    "commands": [
      {
        "command": "ai-tagger",
        "title": "AI 自动标签",
        "kind": "window",
        "entry": "index.html",
        "icon": {
          "light": "icons/context-menu.png",
          "dark": "icons/context-menu.png"
        },
        "window": {
          "width": 1250,
          "height": 850,
          "min_width": 960,
          "min_height": 640,
          "max_width": 1800,
          "max_height": 1200,
          "resizable": true,
          "movable": true,
          "modal": false
        }
      }
    ],
      "context_menus": [
      {
        "command": "ai-tagger",
        "location": "entry_list",
        "when": "has_selection"
      }
    ]
  },
  "l10n": "./l10n",
  "default_locale": "zh-CN"
}
