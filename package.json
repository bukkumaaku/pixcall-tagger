{
    "name": "pixcall-auto-tagger",
    "private": true,
    "version": "2.0.1",
    "type": "module",
    "scripts": {
        "worker:debug": "cargo build --manifest-path backend/Cargo.toml -p ai-worker && node scripts/copy-worker.mjs debug",
        "worker:release": "cargo build --manifest-path backend/Cargo.toml --release -p ai-worker && node scripts/copy-worker.mjs release",
        "dev": "npm run worker:debug && vite",
        "build": "npm run worker:release && vue-tsc -b && vite build",
        "preview": "vite preview",
        "tauri": "tauri"
    },
    "dependencies": {
        "@tauri-apps/api": "^2.5.0",
        "@tauri-apps/plugin-dialog": "~2",
        "@tauri-apps/plugin-http": "~2",
        "@tauri-apps/plugin-opener": "^2",
        "@vicons/ionicons5": "^0.13.0",
        "naive-ui": "^2.44.1",
        "vue": "^3.5.30"
    },
    "devDependencies": {
        "@tauri-apps/cli": "^2",
        "@vitejs/plugin-vue": "^6.0.5",
        "@vue/tsconfig": "^0.9.0",
        "typescript": "~5.9.3",
        "vite": "^7.1.7",
        "vue-tsc": "^3.2.5"
    }
}
