{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "pixcall-auto-tagger",
	"version": "2.0.1",
	"identifier": "com.pixcall-auto-tagger.app",
	"build": {
		"beforeDevCommand": "npm run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "npm run build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "Pixcall AI Tagger",
				"width": 1100,
				"height": 760,
				"minWidth": 760,
				"minHeight": 560,
				"decorations": false,
				"devtools": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"resources": {
			"../bin/win-x64/*": "bin/win-x64/",
			"../tagset.csv": "tagset.csv"
		},
		"icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
	}
}
